# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────
# Local development: mongodb://127.0.0.1:27017/jobwise
# MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/jobwise?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/jobwise

# ── JWT Secrets ──────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_at_least_64_char_hex_for_access_token_signing
JWT_REFRESH_SECRET=replace_with_a_different_64_char_hex_for_refresh_token_signing
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Frontend & CORS ──────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Encryption (AES-256-GCM for sensitive stored tokens/PII) ────────────
# Must be 32 bytes (64 hex characters). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── AI Provider (Anthropic Claude) ───────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL_DEFAULT=claude-3-5-sonnet-20241022
AI_MONTHLY_TOKEN_BUDGET_PER_USER=200000

# ── Storage Driver (local or s3) ─────────────────────────────────────────
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_BUCKET=jobwise-user-files
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=optional_s3_key
S3_SECRET_ACCESS_KEY=optional_s3_secret

# ── Vector Search ────────────────────────────────────────────────────────
VECTOR_INDEX_NAME=job_embeddings_v1

# ── Job Feed Partners ────────────────────────────────────────────────────
JOB_FEED_API_KEY=optional_partner_api_key
JOB_FEED_POLL_CRON=0 3 * * *

# ── Email (Optional in Dev) ──────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your_smtp_key
EMAIL_FROM=noreply@jobwise.app

# ── Monitoring (Optional) ────────────────────────────────────────────────
SENTRY_DSN=
