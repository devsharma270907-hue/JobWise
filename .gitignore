# Dependencies (never commit — reinstall with npm ci)
node_modules/

# Environment & secrets — NEVER commit (only .env.example is allowed)
.env
.env.*
!.env.example

# Private keys and common secret filenames
*.pem
*.key
id_rsa
id_ed25519
*.p12
*.pfx

# Build output
dist/
build/
out/
.next/
.output/
*.tsbuildinfo

# Logs & coverage
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/
.nyc_output/

# Cache, Linters & Test Results
.eslintcache
.cache/
.turbo/
.parcel-cache/
test-results/
playwright-report/

# OS / Editor noise
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.idea/
.vscode/
*.swp
*.swo

# Local storage / uploads (dev uploads only)
uploads/
/storage/
backend/storage/
!backend/src/services/storage/
temp/
tmp/
